# Configuração do Banco de Dados PostgreSQL
# String de conexão completa ao banco PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/nome_banco
# Exemplo: postgresql://postgres:senha@localhost:5432/user_feedback
DATABASE_URL=

# Ambiente de execução (development, production)
NODE_ENV=development

# Prefixo de path quando o app é servido fora da raiz do domínio (opcional, build time)
# Ex.: /user-feedback  ->  https://exemplo.com/user-feedback
NEXT_PUBLIC_BASE_PATH=
